# ============================================================
#  Java 项目 .gitignore
#  作用：告诉 Git 哪些文件"不用管"，不纳入版本控制
#  改完生效：git add .gitignore && git commit -m "添加 .gitignore"
# ============================================================

# ---------- 编译产物（每次编译都变，传上去纯属垃圾） ----------
*.class
*.jar
*.war
*.ear
out/
bin/
target/
build/

# ---------- IDE 配置（每个人的环境不同，不该共享） ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
*.launch

# ---------- 日志与临时文件 ----------
*.log
logs/
*.tmp
*.bak
*.swp
*~

# ---------- 构建工具缓存 ----------
.gradle/
.mvn/
node_modules/

# ---------- 操作系统自动生成的文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 敏感信息（密码、密钥，绝对不能传） ----------
.env
.env.local
*.key
*.pem

# ---------- 你自己想临时忽略的东西，加在下面 ----------
# 例如：
# 草稿.txt
# 练习/
